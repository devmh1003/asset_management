rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자: 아래 목록의 이메일 또는 admins/{email} 문서가 있는 계정
    function isAdmin() {
      return request.auth != null && request.auth.token.email_verified == true && (
        request.auth.token.email in ['devmh1003@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }
    // 기본 관리자(소유자): 이력 삭제처럼 감사 기록을 지우는 작업은 소유자만
    function isOwner() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email in ['devmh1003@gmail.com'];
    }
    function isSelf(uid) { return request.auth != null && request.auth.uid == uid; }
    function profilePath(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function configPath() { return /databases/$(database)/documents/meta/appConfig; }
    // 관리자가 켠 가입 승인제
    function approvalRequired() {
      return exists(configPath()) && get(configPath()).data.get('approvalRequired', false) == true;
    }
    // 쓰기 가능한 계정: 비활성·승인대기가 아닌 계정 (프로필이 없으면 승인제가 꺼져 있을 때만)
    function isActive() {
      return exists(profilePath(request.auth.uid))
        ? (get(profilePath(request.auth.uid)).data.get('disabled', false) != true
           && get(profilePath(request.auth.uid)).data.get('pending', false) != true)
        : !approvalRequired();
    }
    // 사용자가 스스로 바꿀 수 없는 프로필 필드
    function adminOnlyKeys() { return ['disabled', 'pending', 'memo', 'approvedAt', 'approvedBy']; }
    // 프로필에 저장할 수 있는 필드 (그 외 임의 필드 차단)
    function profileKeys() {
      return ['email', 'emailVerified', 'name', 'photo', 'provider', 'createdAt', 'consentAt', 'lastLogin', 'loginCount',
              'disabled', 'pending', 'memo', 'approvedAt', 'approvedBy'];
    }
    // 본인이 쓰는 프로필 값 검증: 이메일은 토큰과 같아야 하고, 이메일 인증 여부는 토큰이 인증된 경우에만 true
    function validSelfProfile() {
      return request.resource.data.email == request.auth.token.get('email', '')
        && (request.resource.data.get('emailVerified', false) != true || request.auth.token.email_verified == true)
        && request.resource.data.keys().hasOnly(profileKeys())
        && request.resource.data.get('name', '') is string && request.resource.data.get('name', '').size() <= 100
        && request.resource.data.get('photo', '') is string && request.resource.data.get('photo', '').size() <= 1000;
    }
    // 사용자 데이터 컬렉션 (store.js COLLECTIONS + meta/settings)
    function userCollections() {
      return ['assets', 'liabilities', 'cashflow', 'history', 'portfolio', 'goals', 'kpis', 'scenarios', 'reports', 'transactions', 'realestate', 'recurring', 'meta'];
    }

    match /admins/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }
    // 관리자가 편집하는 추천 분류 템플릿(taxonomyTemplate)과 운영 설정(appConfig: 공지·가입 승인제)
    match /meta/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /profiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      // 프로필 이메일은 로그인 토큰의 이메일과 같아야 함 (관리자 화면에서 다른 사람으로 위장 방지)
      allow create: if isAdmin() || (isSelf(uid) && validSelfProfile()
        && !request.resource.data.keys().hasAny(['disabled', 'memo', 'approvedAt', 'approvedBy'])
        && (!approvalRequired() || request.resource.data.get('pending', false) == true));
      allow update: if isAdmin() || (isSelf(uid) && validSelfProfile()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(adminOnlyKeys()));
      // 본인 탈퇴 시 삭제 가능 (비활성 계정은 우회 방지를 위해 불가)
      allow delete: if isAdmin() || (isSelf(uid) && resource.data.get('disabled', false) != true);
    }
    // 관리자 메모: 대상 사용자에게 보이지 않도록 프로필과 분리
    match /adminNotes/{uid} {
      allow read, write: if isAdmin();
    }
    // 변경 이력: 본인 이름·서버 시각으로만 추가, 수정 불가, 삭제는 기본 관리자(소유자)만
    match /auditLogs/{logId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.at == request.time
        && request.resource.data.keys().hasOnly(['uid', 'email', 'action', 'target', 'detail', 'at', 'subject'])
        // 로그인·계정 기록은 누구나, 관리자 기록은 관리자만, 데이터 변경 기록은 쓰기 가능한 계정만
        && (request.resource.data.action in ['login', 'signup', 'account']
            || (request.resource.data.action == 'admin' && isAdmin())
            || (request.resource.data.action in ['create', 'update', 'delete', 'bulk', 'import', 'export', 'settings'] && (isAdmin() || isActive())))
        && (!('subject' in request.resource.data) || (request.resource.data.subject is string && request.resource.data.subject.size() <= 128))
        && request.resource.data.target is string && request.resource.data.target.size() <= 300
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 2000;
      allow update: if false;
      allow delete: if isOwner();
    }
    // 각 사용자는 자신의 users/{uid}/{컬렉션}/{문서} 만 읽고 쓸 수 있음. 관리자는 열람·정리 가능
    // 정해진 컬렉션 외의 경로·하위 중첩 문서는 쓰기 불가 (무료 한도 남용 방지)
    match /users/{uid}/{coll}/{docId} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if coll in userCollections()
        && (coll != 'meta' || docId == 'settings')
        && ((isSelf(uid) && isActive()) || isAdmin());
    }
  }
}
